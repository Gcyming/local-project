    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.3.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
