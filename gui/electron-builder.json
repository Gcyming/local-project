{
  "appId": "com.slime.gui",
  "productName": "Slime",
  "copyright": "Copyright © 2026 slime",
  "directories": {
    "output": "release-final",
    "buildResources": "build"
  },
  "electronDist": "node_modules/electron/dist",
  "files": [
    "out/**/*",
    "!out/_zoom/**",
    "!out/_zoom2/**",
    "!out/bench/**",
    "!out/layout-probe/**",
    "!out/browser-error-probe/**",
    "!out/_*.txt",
    "!out/_*.json",
    "../core-ts/src/**/*",
    "../requirements.txt",
    "../slime_server.py",
    "../slime_cli.py",
    "template/slime.toml"
  ],
  "extraFiles": [
    {
      "from": "../runtime/venv",
      "to": "runtime/venv",
      "filter": ["**/*", "!**/__pycache__/**", "!**/tests/**", "!**/test/**"]
    },
    {
      "from": "../llama.cpp/build/bin",
      "to": "llama.cpp/build/bin",
      "filter": [
        "**/*",

        "!**/ggml-cuda.dll",
        "!**/cublas64_12.dll",
        "!**/cublasLt64_12.dll",
        "!**/cudart64_12.dll",

        "!**/ggml-rpc.dll",
        "!**/ggml-rpc-server.exe",

        "!**/llama-bench.exe",
        "!**/llama-bench-impl.dll",
        "!**/llama-batched-bench.exe",
        "!**/llama-batched-bench-impl.dll",
        "!**/llama-completion.exe",
        "!**/llama-completion-impl.dll",
        "!**/llama-fit-params.exe",
        "!**/llama-fit-params-impl.dll",
        "!**/llama-gguf-split.exe",
        "!**/llama-gemma3-cli.exe",
        "!**/llama-imatrix.exe",
        "!**/llama-llava-cli.exe",
        "!**/llama-minicpmv-cli.exe",
        "!**/llama-mtmd-debug.exe",
        "!**/llama-perplexity.exe",
        "!**/llama-perplexity-impl.dll",
        "!**/llama-qwen2vl-cli.exe",
        "!**/llama-quantize.exe",
        "!**/llama-quantize-impl.dll",
        "!**/llama-results.exe",
        "!**/llama-template-analysis.exe",
        "!**/llama-tokenize.exe",
        "!**/llama-tts.exe"
      ]
    },
    {
      "from": "../slime_server.py",
      "to": "slime_server.py"
    },
    {
      "from": "template/skills",
      "to": "template/skills"
    },
    {
      "from": "../slime_cli.py",
      "to": "slime_cli.py"
    },
    {
      "from": "../requirements.txt",
      "to": "requirements.txt"
    },
    { "from": "template/slime.toml", "to": "slime.toml" },
    { "from": "build/icon.png", "to": "build/icon.png" },
    { "from": "build/icon.ico", "to": "build/icon.ico" },
    { "from": "build/notify-icon.png", "to": "build/notify-icon.png" },
    { "from": "../core", "to": "core", "filter": ["**/*"] },
    { "from": "../tools", "to": "tools", "filter": ["**/*"] },
    { "from": "../social", "to": "social", "filter": ["**/*"] },
    { "from": "../sidecar", "to": "sidecar", "filter": ["**/*", "!__pycache__/**"] },
    { "from": "../models/情感脑-silam-sigma-80m/backbone_80m.npz", "to": "models/情感脑-silam-sigma-80m/backbone_80m.npz" },
    { "from": "../models/对话脑-v3.1L-6921词表/lang_core_d16.npz", "to": "models/对话脑-v3.1L-6921词表/lang_core_d16.npz" },
    { "from": "../configs/vocab.v3.1-6921.json", "to": "configs/vocab.v3.1-6921.json" },
    { "from": "../_model_stage/silam_core", "to": "_model_stage/silam_core", "filter": ["**/*"] },
    { "from": "../_model_stage/tools/lang_core.py", "to": "_model_stage/tools/lang_core.py" }
  ],
  "asar": true,
  "asarUnpack": [
    "out/main/chunks/*.node",
    "../core-ts/src/**/*"
  ],
  "compression": "maximum",
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "icon": "build/icon.ico"
  },
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] }
    ],
    "icon": "build/icon.png",
    "category": "Utility",
    "maintainer": "slime",
    "synopsis": "slime AI Agent platform"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "language": 2052,
    "shortcutName": "Slime",
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": false,
    "createStartMenuShortcut": true,
    "include": "installer.nsh"
  },
  "publish": {
    "provider": "github",
    "owner": "Gcyming",
    "repo": "local-project",
    "private": true,
    "releaseType": "release"
  }
}
