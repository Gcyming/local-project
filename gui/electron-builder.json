{
  "appId": "com.slime.gui",
  "productName": "Slime",
  "copyright": "Copyright © 2026 slime",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "out/**/*",
    "../core-ts/src/**/*",
    "../requirements.txt",
    "../slime_server.py",
    "../slime_cli.py",
    "../slime.toml"
  ],
  "extraFiles": [
    {
      "from": "../runtime/venv",
      "to": "runtime/venv",
      "filter": ["**/*"]
    },
    {
      "from": "../models",
      "to": "models",
      "filter": ["**/*"]
    },
    {
      "from": "../llama.cpp/build/bin",
      "to": "llama.cpp/build/bin",
      "filter": ["**/*"]
    },
    {
      "from": "../slime_server.py",
      "to": "slime_server.py"
    },
    {
      "from": "../slime_cli.py",
      "to": "slime_cli.py"
    },
    {
      "from": "../slime.toml",
      "to": "slime.toml"
    }
  ],
  "asar": true,
  "asarUnpack": [
    "out/main/chunks/*.node",
    "../core-ts/src/**/*"
  ],
  "compression": "maximum",
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "icon": "build/icon.png"
  },
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] }
    ],
    "icon": "build/icon.png",
    "category": "Utility",
    "maintainer": "slime",
    "synopsis": "slime AI Agent platform"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "language": 2052,
    "shortcutName": "Slime"
  },
  "publish": {
    "provider": "github",
    "owner": "Gcyming",
    "repo": "local-project",
    "private": true,
    "releaseType": "release"
  }
}
