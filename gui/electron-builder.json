{
  "appId": "com.slime.gui",
  "productName": "Slime",
  "copyright": "Copyright © 2026 slime",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": ["out/**/*"],
  "asar": true,
  "asarUnpack": ["out/main/chunks/*.node"],
  "compression": "maximum",
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "icon": "build/icon.png"
  },
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] }
    ],
    "category": "Development",
    "icon": "build/icon.png",
    "executableName": "slime"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "language": 2052,
    "shortcutName": "Slime"
  },
  "publish": {
    "provider": "github",
    "owner": "Gcyming",
    "repo": "local-project",
    "private": true,
    "releaseType": "release"
  }
}
