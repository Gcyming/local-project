{
  "name": "hello-slime",
  "version": "1.0.0",
  "description": "官方示例扩展（活教材）：把插件全部贡献类型演示一遍——设置项 / 四个 UI 槽位 / 脚本工具 / 自有页面 / 运行模式 / 主题皮肤 / 指令。当用户想了解 slime 扩展机制、想要一份可照抄的插件样例，或想体验「可开可关」的皮肤与面板时使用。",
  "origin": "agent",
  "provides": ["instructions", "mode"],
  "contributes": {
    "settings": [
      {
        "key": "greeting",
        "label": "问候语",
        "type": "string",
        "default": "你好，slime",
        "hint": "示例设置项：值只存在本扩展自己的目录里，不影响 slime 主配置"
      }
    ],
    "ui": [
      { "slot": "settings_panel", "id": "about", "title": "示例扩展说明" },
      { "slot": "status_item", "id": "badge", "label": "示例扩展在岗", "refresh": "manual" },
      { "slot": "chat_action", "id": "stamp", "label": "插入示例问候", "when": "任何时候" },
      { "slot": "toolbar_item", "id": "open", "label": "打开示例面板" }
    ],
    "scripts": [
      {
        "name": "hello",
        "entry": "tools/hello.mjs",
        "description": "示例脚本工具：报一声当前时间并回显一句话（演示「用户信任后才装配」的脚本贡献）"
      }
    ],
    "page": { "kind": "html", "entry": "panel.html" },
    "theme": {
      "name": "示例·暮色青",
      "tokens": {
        "accent": "#2dd4bf",
        "accentHover": "#5eead4",
        "accentSoft": "#2dd4bf29",
        "bg": "#071312",
        "bgSecondary": "#0c1f1d",
        "bgCard": "#0e211f",
        "bgInput": "#0a1a18",
        "bgHover": "#143833",
        "border": "#1d4a44",
        "text": "#e7f6f3",
        "textSecondary": "#9fd0c8",
        "textMuted": "#6d9a93",
        "font": "system",
        "radius": "round"
      }
    }
  },
  "mode": {
    "kind": "stages",
    "stages": [
      {
        "id": "greet",
        "title": "示例·问好",
        "prompt": "用一句话向用户问好，并说明这是官方示例扩展的阶段机第一阶段。不要调用任何工具。",
        "maxRounds": 3
      },
      {
        "id": "wrap",
        "title": "示例·收束",
        "prompt": "基于上一阶段的内容，用一句话收束：告诉用户示例阶段机到此结束，把会话顶部的运行模式切回「默认」即可退出。不要调用任何工具。",
        "requirePrevious": "greet",
        "maxRounds": 3
      }
    ]
  }
}
