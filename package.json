{
  "name": "slime",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:contracts": "py scripts/gen_contracts.py",
    "contract:check": "node scripts/contract-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "dev:gui": "pnpm --filter slime-gui dev",
    "typecheck:gui": "pnpm --filter slime-gui type"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jszip": "^3.10.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.37.1",
    "better-sqlite3": "^13.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "onnxruntime-node",
      "sharp"
    ]
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
