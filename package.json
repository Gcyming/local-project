{
  "name": "slime",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:contracts": "py scripts/gen_contracts.py",
    "contract:check": "node scripts/contract-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.base.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.37.1",
    "better-sqlite3": "^13.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "onnxruntime-node",
      "sharp"
    ]
  }
}
