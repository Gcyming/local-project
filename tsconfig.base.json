{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": false,
    "jsx": "react-jsx",
    "typeRoots": ["./node_modules/@types", "./gui/node_modules/@types"],
    "types": ["node", "react", "react-dom"],
    "paths": {
      "react": ["./gui/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./gui/node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom": ["./gui/node_modules/@types/react-dom/index.d.ts"]
    }
  },
  "include": [
    "core-ts/src/**/*.ts",
    "gateway-ts/src/**/*.ts",
    "shared/gen/**/*.ts",
    "tests/core-ts/**/*.ts",
    "tests/core-ts/**/*.d.ts"
  ]
}